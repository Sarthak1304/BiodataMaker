# Postgres (Vercel/Neon) — ask the project owner for the real connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Google OAuth (console.cloud.google.com -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Message encryption — random 32-byte secret (e.g. `openssl rand -base64 32`).
# Required for messaging; content is unreadable without it, so losing it
# means losing access to existing message history.
MESSAGE_ENCRYPTION_KEY="replace-with-a-random-32-byte-secret"

# Vercel Blob (for photo / uploaded-file storage)
BLOB_READ_WRITE_TOKEN=""

# Anthropic (used later for AI extraction of uploaded biodata files)
ANTHROPIC_API_KEY=""
