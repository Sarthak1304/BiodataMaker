generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Auth (NextAuth / Auth.js — Prisma adapter shape) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core domain ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  authProvider  String    @default("google")
  isGuest       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  biodata         Biodata[]
  sentMessages    Message[]    @relation("SentMessages")
  receivedMessages Message[]   @relation("ReceivedMessages")
  sentInterests    Interest[]  @relation("SentInterests")
  receivedInterests Interest[] @relation("ReceivedInterests")
}

model Biodata {
  id         String  @id @default(cuid())
  userId     String
  templateId String  @default("traditional-floral")

  // Structured sections — stored as JSON to keep the schema flexible
  // while `src/types/biodata.ts` defines the actual shape used in code.
  personal           Json
  family             Json
  education          Json
  career             Json
  astro              Json
  contact            Json
  partnerPreference  Json
  photoUrl           String?
  photoShape         String  @default("circle")
  additionalPhotos   Json?

  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  interests Interest[]

  @@index([userId])
  @@index([isPublic])
}

model Template {
  id               String @id
  name             String
  previewImageUrl  String?
  styleMetadata    Json?
  isAvailable      Boolean @default(true)
}

model Message {
  id         String    @id @default(cuid())
  fromUserId String
  toUserId   String
  biodataId  String?
  content    String    @db.Text
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  fromUser User     @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User     @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)
  biodata  Biodata? @relation(fields: [biodataId], references: [id], onDelete: SetNull)

  @@index([fromUserId])
  @@index([toUserId])
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Interest {
  id         String         @id @default(cuid())
  fromUserId String
  toUserId   String
  biodataId  String?
  status     InterestStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  fromUser User     @relation("SentInterests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User     @relation("ReceivedInterests", fields: [toUserId], references: [id], onDelete: Cascade)
  biodata  Biodata? @relation(fields: [biodataId], references: [id], onDelete: SetNull)

  @@unique([fromUserId, toUserId])
}
